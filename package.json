{
  "name": "glob-benchmark",
  "version": "0.0.0",
  "packageManager": "pnpm@10.10.0",
  "type": "module",
  "scripts": {
    "test:all": "mise exec -- node --import @oxc-node/core/register -e \"const fs = require('fs'); const files = fs.readdirSync('tests').filter(f => f.endsWith('.ts')); let i = 0; function runNext() { if (i < files.length) { console.log('Running:', files[i]); require('./tests/' + files[i]); i++; setTimeout(runNext, 1000); } } runNext();\"",
    "lint:fix": "eslint --cache --fix",
    "lint": "eslint --cache",
    "format:fix": "prettier --write .",
    "format": "prettier --check ."
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "glob": "^11.0.3",
    "globalyzer": "^0.1.4",
    "globby": "^14.1.0",
    "globrex": "^0.1.2",
    "picomatch": "^4.0.3",
    "tiny-glob": "^0.2.9",
    "tinyglobby": "file:./tinyglobby"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@oxc-node/core": "^0.0.32",
    "@prettier/plugin-oxc": "^0.0.4",
    "@types/node": "^22.16.4",
    "eslint": "^9.31.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100,
    "plugins": [
      "@prettier/plugin-oxc"
    ]
  }
}
